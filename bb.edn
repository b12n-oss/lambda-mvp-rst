{:tasks
 {:requires ([babashka.fs :as fs]
            [babashka.process :as p]
            [clojure.string :as str])

  :init
  (do
    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))

    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task repo-root] (remove nil? args))
              res  (apply p/shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this. It checks the engine out itself.")
          (System/exit 1))))

    (defn jolt-diplomat-dir
      "Where jolt-diplomat is checked out: $JOLT_DIPLOMAT_DIR, else a sibling
       directory, else the usual spot. nil when none of them exist. `bb
       vendor` copies a subset of that checkout's source (backend/,
       examples/json/json_capi/, runtime/, bind.clj) into vendor/ so the
       Dockerfile can build json_capi's Rust cdylib + Clojure bindings for
       AL2023/Linux inside the image, matching that OS's glibc -- see
       docs/guide/json-via-diplomat.md."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JOLT_DIPLOMAT_DIR")
              "../github--jolt-lang--jolt-diplomat"
              (str home "/dev/github--jolt-lang--jolt-diplomat")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bind.clj"))))
             first))))

  info {:doc "task cheat-sheet"
        :task (do (println "lambda-mvp-rst -- a shareable AWS Lambda custom runtime in jolt")
                  (println "")
                  (println "  jolt probe       offline e2e: mock Runtime API + jolt loop (no AWS, no Docker)")
                  (println "  jolt demo        image + deploy + invoke in one go, prerequisites checked first")
                  (println "  jolt image       AL2023 Docker build -> dist/bootstrap + dist/lambda.zip")
                  (println "  jolt deploy      idempotent: create/update the IAM role + Lambda function")
                  (println "  jolt invoke      single ad-hoc invoke, prints response + REPORT line")
                  (println "  jolt bench       cold/warm boot-time comparison across memory tiers")
                  (println "  jolt test        run script/bench.clj's unit tests")
                  (println "  jolt teardown    delete the function + role")
                  (println "  jolt clean       remove build artifacts")
                  (println "  jolt site:build  build the docs site into _site/ (needs a docs-engine checkout)")
                  (println "  jolt site:serve  build the docs site and serve it locally")
                  (println "  jolt site:clean  delete the _site/ build output")
                  (println "")
                  (println "(babashka is still required -- several tasks shell out to a real `bb`")
                  (println " binary internally. `bb <task>` also works if you'd rather type that.)")
                  (println "")
                  (println "No task hardcodes an AWS profile, account, or region -- see README.md"))}

  sync-bindings {:doc "copy jolt-diplomat's diplomat.runtime + json_capi's generated Clojure bindings into src/diplomat/ (dev-only; the Dockerfile does the equivalent inside the image build)"
                  :task (let [src (jolt-diplomat-dir)]
                          (if-not src
                            (do (println "jolt-diplomat is not checked out anywhere I looked:")
                                (println "  $JOLT_DIPLOMAT_DIR, ../github--jolt-lang--jolt-diplomat,")
                                (println "  ~/dev/github--jolt-lang--jolt-diplomat")
                                (System/exit 1))
                            (let [generated (fs/file src "examples" "json" "generated" "diplomat")
                                  rt-dir    (fs/file src "runtime" "src" "diplomat")
                                  dest      (fs/file "src" "diplomat")]
                              (when-not (fs/exists? generated)
                                (println "No generated bindings at" (str generated))
                                (println "Run jolt-diplomat's own `jolt bind.clj examples/json/json_capi --release` first.")
                                (System/exit 1))
                              (fs/delete-tree dest {:force true})
                              (fs/create-dirs dest)
                              ;; runtime/src/diplomat/*.clj: runtime.clj plus its own
                              ;; helper namespaces (thingy.clj, generated_offsets.clj)
                              ;; -- runtime.clj requires diplomat.generated-offsets, so
                              ;; copying only runtime.clj is not enough.
                              (doseq [f (fs/list-dir rt-dir)]
                                (fs/copy f (fs/file dest (fs/file-name f))))
                              (doseq [f (fs/list-dir generated)]
                                (fs/copy f (fs/file dest (fs/file-name f)) {:replace-existing true}))
                              (println "src/diplomat <-" (str src)))))}

  probe {:doc "offline e2e: mock Runtime API on an OS-assigned port + the demo handler"
         :task (let [port-file ".mock-runtime-api-port"]
                 (when-not (fs/exists? "src/diplomat") (p/shell "bb" "sync-bindings"))
                 (when (.exists (java.io.File. port-file)) (.delete (java.io.File. port-file)))
                 (let [srv (p/process ["python3" "tools/mock_runtime_api.py"]
                                      {:inherit true})]
                   (loop [n 0]
                     (when (and (not (.exists (java.io.File. port-file))) (< n 50))
                       (Thread/sleep 100)
                       (recur (inc n))))
                   (if-not (.exists (java.io.File. port-file))
                     (do (println "probe: mock server did not publish its port -- aborting")
                         (System/exit 1))
                     (let [port (.trim (slurp port-file))
                           demo-dir (or (System/getenv "JSON_CAPI_DEMO_DIR")
                                        (when-let [jd (jolt-diplomat-dir)] (str jd "/examples/json")))]
                       (p/shell {:extra-env (cond-> {"AWS_LAMBDA_RUNTIME_API" (str "127.0.0.1:" port)}
                                              demo-dir (assoc "JSON_CAPI_DEMO_DIR" demo-dir))}
                                "joltc run -m net.b12n.lambda-mvp.main")
                       (System/exit (:exit (deref srv)))))))}

  vendor {:doc "copy the jolt-diplomat subset (json_capi/backend/runtime/bind.clj) into vendor/ for the Docker build"
          :task (let [src (jolt-diplomat-dir)]
                  (if-not src
                    (do (println "jolt-diplomat is not checked out anywhere I looked:")
                        (println "  $JOLT_DIPLOMAT_DIR, ../github--jolt-lang--jolt-diplomat,")
                        (println "  ~/dev/github--jolt-lang--jolt-diplomat")
                        (System/exit 1))
                    (do (fs/delete-tree "vendor" {:force true})
                        (fs/create-dirs "vendor/jolt-diplomat")
                        (doseq [rel ["backend" "runtime" "examples/json/json_capi" "bind.clj"]]
                          (let [from (fs/file src rel)
                                to   (fs/file "vendor/jolt-diplomat" rel)]
                            (fs/create-dirs (fs/parent to))
                            (if (fs/directory? from)
                              (do (fs/copy-tree from to)
                                  ;; host-built Rust artifacts -- irrelevant
                                  ;; (wrong OS/glibc) and huge; the Docker
                                  ;; build does its own cargo build inside
                                  ;; AL2023. Covers target/, target-traced/,
                                  ;; any --out-suffix variant bind.clj made.
                                  (doseq [t (fs/list-dir to)]
                                    (when (str/starts-with? (fs/file-name t) "target")
                                      (fs/delete-tree t))))
                              (fs/copy from to))))
                        (println "vendor/jolt-diplomat <-" src))))}

  image {:doc "build bootstrap + lambda.zip in an amazonlinux:2023 container (LAMBDA_ARCH, default arm64; IMPORT_CA_CERT=false to skip the ZScaler CA import)"
         :task (let [jolt-version (System/getenv "JOLT_VERSION")
                     chez-version (System/getenv "CHEZ_VERSION")
                     base (System/getenv "BASE_IMAGE")
                     import-ca (System/getenv "IMPORT_CA_CERT")
                     ;; Lambda spells it x86_64, Docker amd64 -- accept both.
                     arch (or (System/getenv "LAMBDA_ARCH") "arm64")
                     platform (case arch
                                "arm64" "linux/arm64"
                                ("x86_64" "amd64") "linux/amd64"
                                (do (println "image: LAMBDA_ARCH must be arm64 or x86_64, got" arch)
                                    (System/exit 1)))]
                 (when-not (fs/exists? "vendor/jolt-diplomat")
                   (p/shell "bb" "vendor"))
                 (p/shell (str "docker build --target export --output dist --platform " platform " "
                               (if jolt-version (str "--build-arg JOLT_VERSION=" jolt-version " ") "")
                               (if chez-version (str "--build-arg CHEZ_VERSION=" chez-version " ") "")
                               (if base (str "--build-arg BASE_IMAGE=" base " ") "")
                               (if import-ca (str "--build-arg IMPORT_CA_CERT=" import-ca " ") "")
                               ".")))}

  demo {:doc "image + deploy + invoke in one go, checking every prerequisite before starting"
        :task (p/shell "bb" "script/demo.clj")}

  clean {:doc "remove build artifacts"
         :task (p/shell "rm -rf dist bootstrap bootstrap.build")}

  deploy {:doc "idempotent: create/update the IAM role + Lambda function from your aws CLI config"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "deploy")}

  invoke {:doc "single ad-hoc invoke, prints response + REPORT line"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "invoke")}

  teardown {:doc "delete the function + role"
            :task (p/shell "bb" "script/aws_lifecycle.clj" "teardown")}

  bench {:doc "cold/warm boot-time comparison across memory tiers"
         :task (p/shell "bb" "script/bench_run.clj")}

  test {:doc "run script/bench.clj's unit tests"
        :task (p/shell "bb" "test/bench_test.clj")}

  site:build {:doc "build the docs site into _site/ (needs a docs-engine checkout)"
              :task (site-task "build")}

  site:serve {:doc "build the docs site and serve it locally (bb site:serve [port], default 3000)"
              :task (site-task "serve" (first *command-line-args*))}

  site:clean {:doc "delete the _site/ build output"
              :task (site-task "clean")}}}
